// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum CheckpointType {
  DAY // сутки
  WEEK // неделя
  MONTH // месяц
  CUSTOM // своя дата, задана вручную при добавлении действия
}

enum CheckpointStatus {
  PENDING // ожидает
  DONE // снято
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  actions Action[]
}

model Action {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  date      DateTime // дата действия
  place     String // место действия — кампания/группа/URL
  description String // суть действия
  justification String? // обоснование — почему сделали именно так
  note        String? // примечание — свободная заметка
  reportUrl String? // ссылка на отчёт
  createdAt DateTime @default(now())

  checkpoints Checkpoint[]
}

model Checkpoint {
  id          String           @id @default(cuid())
  action      Action           @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId    String
  type        CheckpointType
  plannedDate DateTime // дата действия + 1 / +7 / +30 дней
  status      CheckpointStatus @default(PENDING)
  result      String? // вписывается в момент снятия
}
