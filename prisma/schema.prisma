// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum CheckpointType {
  DAY // сутки
  WEEK // неделя
  MONTH // месяц
  CUSTOM // своя дата, задана вручную при добавлении действия
}

enum CheckpointStatus {
  PENDING // ожидает
  DONE // снято
}

enum GoalLevel {
  MACRO
  MICRO
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // ——— Вводные ———
  topic               String? // Тематика
  site                String? // Сайт
  budget              String? // Бюджет
  regions             String? // Регионы
  priorities          String? // Приоритеты
  businessGoals       String? // Бизнес-цели
  qualifiedLeadParams String? // Параметры квал. лидов
  clientWishes        String? // Пожелания клиента
  constraints         String? // Ограничения
  directLogin         String? // Логин в Директе

  // ——— Свободные разделы (порядок пунктов — порядок строк в тексте) ———
  history   String? // История крупными мазками: вехи, решения, тесты, результаты
  problems  String? // Текущие нерешённые проблемы, в порядке приоритета
  questions String? // Вопросы к анализу, на которые нет готового ответа

  actions   Action[]
  links     ProjectLink[]
  goals     ProjectGoal[]
  risks     ProjectRisk[]
  passwords ProjectPassword[]
}

// Важные ссылки проекта — клиентский отчёт, визуализация и т.д.
model ProjectLink {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  label     String
  url       String
  order     Int     @default(0)
}

// Карта целей — таблица целей Метрики/Директа, на которые ориентируется проект.
model ProjectGoal {
  id             String    @id @default(cuid())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  goalId         String // ID цели в Метрике/Директе
  name           String
  level          GoalLevel
  description    String?
  validDatesNote String? // с какой даты можно доверять данным по цели
  order          Int       @default(0)
}

// Риски проекта — что регулярно проверять и где, чтобы не пропустить проблему.
model ProjectRisk {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  risk      String // суть риска
  url       String? // ссылка для проверки
  frequency String? // как часто проверять — «1 р/день», «пон, чт - 2 р/нед»
  order     Int     @default(0)
}

// Логины/пароли по проекту — хранятся как обычный текст в личной базе, без шифрования:
// это тот же уровень доступа, что и у остальных данных проекта.
model ProjectPassword {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  label     String // например «Яндекс.Директ», «Метрика»
  value     String
  order     Int     @default(0)
}

model Action {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  date      DateTime // дата действия
  place     String // место действия — кампания/группа/URL
  description String // суть действия
  justification String? // обоснование — почему сделали именно так
  note        String? // примечание — свободная заметка
  reportUrl String? // ссылка на отчёт
  createdAt DateTime @default(now())

  checkpoints Checkpoint[]
}

model Checkpoint {
  id          String           @id @default(cuid())
  action      Action           @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId    String
  type        CheckpointType
  plannedDate DateTime // дата действия + 1 / +7 / +30 дней
  status      CheckpointStatus @default(PENDING)
  result      String? // вписывается в момент снятия
}

// Свободные заметки/промпты — отдельно от дневника правок, просто место для хранения
// текста под рукой (аналог Google Keep).
model Note {
  id        String   @id @default(cuid())
  title     String? // необязательный — не всегда нужен для короткой заметки
  text      String
  color     String   @default("default") // ключ цвета фона, см. NOTE_COLORS в коде
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
