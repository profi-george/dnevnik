# Локальная разработка — обычный файл SQLite, ничего настраивать не нужно.
DATABASE_URL="file:./dev.db"

# Массовый ИИ-разбор действий (страница /diary/bulk). Ключ из aistudio.google.com/apikey.
GEMINI_API_KEY=""

# Нужны только в проде (Vercel) — файловая система там read-only, поэтому база
# переезжает в облачный SQLite (Turso). Локально эти две переменные не задавайте —
# тогда приложение само использует DATABASE_URL выше.
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN=""
